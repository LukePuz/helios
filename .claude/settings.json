{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai_log.py\" prompt || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai_log.py\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai_log.py\" stop || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai_log.py\" stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai_log.py\" end || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai_log.py\" end",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai_log.py\" sweep || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai_log.py\" sweep",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
