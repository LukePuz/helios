ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

SUPABASE_HOST=your-project-ref.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your_supabase_db_password_here

TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token-here
TELEGRAM_CHAT_ID=your_chat_id_here

# Redis (local Docker/native or remote URL)
REDIS_URL=redis://localhost:6379/0

# Interactive Brokers TWS/Gateway
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# Ollama (local LLM server)
OLLAMA_HOST=http://localhost:11434
SCREENER_MODEL=qwen2.5:7b
ANALYST_MODEL=qwen2.5:72b

# Market data APIs
POLYGON_API_KEY=your_key_here
FRED_API_KEY=your_key_here
UNUSUAL_WHALES_API_KEY=your_key_here
QUIVER_API_KEY=your_key_here

# Environment and live-trading opt-ins. Live needs BOTH (README, "Execution").
TRADING_ENV=paper
LIVE_TRADING_ENABLED=false
# Starting value used for the live track record's return baseline.
# LIVE_START_VALUE=

# Telegram: numeric user ids allowed to issue chat commands (comma-separated).
# Empty means nobody: the mention handler fails closed.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_BOT_USERNAME=your_bot_username

# Second Ollama instance for screening on CPU, and the chat model.
OLLAMA_CPU_HOST=http://localhost:11435
# CHAT_MODEL=

# Strategy switches (defaults shown; see config.py for what each does).
SETUP_GATES_ENABLED=false
ETF_FUNDAMENTALS_CAP_EXEMPT=false
USE_BRACKET_ORDERS=false
ALLOW_ONE_SHARE_ABOVE_ALLOCATION=true
EARNINGS_ENTRY_BLACKOUT_DAYS=0
# Optional analyst brief sections (off by default; research decision).
BRIEF_PRICE_STRUCTURE=false
BRIEF_POSITION_CONTEXT=false

# Catalyst calendar service and local DB.
# CATALYST_SERVICE_URL=
# CATALYST_DB_PATH=

# Postgres pool size per process (optional).
# DB_MAXCONN=
# Where the AI prompt-log hooks write (research-log/README.md).
# HELIOS_AI_LOG_DIR=
