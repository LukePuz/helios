[Unit]
Description=Helios Hedgefund trading bot (local checkout)
# Deliberately NOT tied to a specific IBC unit (ibc.service/ibc-live.service)
# via After=/Requires= -- this unit serves both paper and live depending on
# .env's TRADING_ENV, and hard-wiring the paper one here meant a live-mode
# restart would try to start paper's TWS (needing its own unrelated 2FA
# scan) while wait-for-ibkr.sh's protocol-level check is what actually
# verifies the correct account's port is reachable anyway. Found 2026-08-16
# the night before enabling live. Both IBC units already self-heal via
# their own Restart=always.
After=network-online.target
Wants=network-online.target
# Telegram alert when this unit gives up restarting (see StartLimit* below)
# — covers the "TWS 2FA hung waiting for a factor no script can provide"
# case, which previously just retried every 10s forever with nobody told
# the bot never came up for the trading day.
OnFailure=helios-notify-failure@%n.service
# Stop retrying after 5 failures in 10 minutes rather than forever — a
# genuinely stuck IBKR login (2FA prompt) isn't going to resolve itself on
# attempt #200, and hitting this limit is what puts the unit into "failed"
# and fires OnFailure= above.
StartLimitIntervalSec=600
StartLimitBurst=5
# Mutual exclusion with the overnight standby listener — see
# helios-standby.service. Ensures the two never both hold the Telegram
# long-poll at once (Telegram 409s a second concurrent getUpdates caller),
# regardless of whether this unit was started by helios-start.timer or by
# standby_bot.py's own wake trigger.
Conflicts=helios-standby.service

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/Desktop/trading_bot
# Blocks startup until TWS's API port actually accepts connections — IBC's
# headless login can take well over a minute; without this, main.py's own
# retry logic would be racing IBC on every cold morning start.
ExecStartPre=/home/YOUR_USER/Desktop/trading_bot/deploy/systemd/wait-for-ibkr.sh 180
ExecStart=/home/YOUR_USER/Desktop/trading_bot/venv/bin/python /home/YOUR_USER/Desktop/trading_bot/main.py
Restart=on-failure
RestartSec=10

StandardOutput=append:/home/YOUR_USER/Desktop/trading_bot/helios-systemd.log
StandardError=append:/home/YOUR_USER/Desktop/trading_bot/helios-systemd.log

[Install]
WantedBy=multi-user.target
