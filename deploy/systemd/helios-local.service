[Unit]
Description=Helios Hedgefund trading bot (local checkout)
After=network-online.target ibc.service
Wants=network-online.target
Requires=ibc.service
# Telegram alert when this unit gives up restarting (see StartLimit* below)
# — covers the "TWS 2FA hung waiting for a factor no script can provide"
# case, which previously just retried every 10s forever with nobody told
# the bot never came up for the trading day.
OnFailure=helios-notify-failure@%n.service
# Stop retrying after 5 failures in 10 minutes rather than forever — a
# genuinely stuck IBKR login (2FA prompt) isn't going to resolve itself on
# attempt #200, and hitting this limit is what puts the unit into "failed"
# and fires OnFailure= above.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=luke-puzenski
WorkingDirectory=/home/luke-puzenski/Desktop/trading_bot
# Blocks startup until TWS's API port actually accepts connections — IBC's
# headless login can take well over a minute; without this, main.py's own
# retry logic would be racing IBC on every cold morning start.
ExecStartPre=/home/luke-puzenski/Desktop/trading_bot/deploy/systemd/wait-for-ibkr.sh 180
ExecStart=/home/luke-puzenski/Desktop/trading_bot/venv/bin/python /home/luke-puzenski/Desktop/trading_bot/main.py
Restart=on-failure
RestartSec=10

StandardOutput=append:/home/luke-puzenski/Desktop/trading_bot/helios-systemd.log
StandardError=append:/home/luke-puzenski/Desktop/trading_bot/helios-systemd.log

[Install]
WantedBy=multi-user.target
