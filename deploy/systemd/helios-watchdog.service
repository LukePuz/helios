[Unit]
Description=Helios external liveness watchdog (one-shot check)

[Service]
Type=oneshot
User=luke-puzenski
WorkingDirectory=/home/luke-puzenski/Desktop/trading_bot
ExecStart=/home/luke-puzenski/Desktop/trading_bot/venv/bin/python /home/luke-puzenski/Desktop/trading_bot/deploy/watchdog.py
StandardOutput=append:/home/luke-puzenski/Desktop/trading_bot/logs/watchdog.log
StandardError=append:/home/luke-puzenski/Desktop/trading_bot/logs/watchdog.log
