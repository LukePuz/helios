[Unit]
Description=Ollama, CPU-only instance for the small models (screener 7B, chat 3B)
# Second server on :11435 so the high-volume small-model traffic never shares
# a scheduler with the 72B analyst on the main ollama.service (:11434).
# Found 2026-10-25: with both on one server, a continuous stream of 7B
# screening calls kept the 72B from ever loading (zero loads in 6+ hours,
# every analysis a stub), even though num_gpu=0 kept the 7B off the GPUs.
# Clients: agents/screener.py and chat_assistant.py (OLLAMA_CPU_HOST), which
# fall back to :11434 if this unit isn't running.
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="OLLAMA_HOST=127.0.0.1:11435"
# Same model store as the main server (read-only use; no separate pulls).
Environment="OLLAMA_MODELS=/usr/share/ollama/.ollama/models"
# Never prune blobs here: the store is shared with the main server.
Environment="OLLAMA_NOPRUNE=1"
# Hide every GPU, CUDA and Vulkan alike. The clients already send num_gpu=0,
# but GPU discovery alone opens a CUDA context and reserves VRAM the 72B needs.
Environment="CUDA_VISIBLE_DEVICES=-1"
Environment="GGML_VK_VISIBLE_DEVICES=-1"
Environment="OLLAMA_VULKAN=0"
# Screening runs at higher concurrency than the analyst; 2 slots matches what
# the main server's override gave it before the split.
Environment="OLLAMA_NUM_PARALLEL=2"

[Install]
WantedBy=default.target
